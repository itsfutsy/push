[Desktop Entry]
Type=Application
Name={{name}}
Comment={{comment}}
Exec={{exec}} %F
Icon={{icon}}
Terminal=false
Categories={{categories}}
StartupWMClass={{exec}}
# No MimeType on purpose: any claimed type can make Push the default opener on Linux,
# and opening a file uploads it. Files reach Push by drag and drop, the picker, or `push FILE`.
Actions=capture;

[Desktop Action capture]
Name=Capture Area
Exec={{exec}} --capture
