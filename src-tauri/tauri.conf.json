{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Push",
  "identifier": "io.github.itsfutsy.push",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Push",
        "url": "index.html",
        "width": 380,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "acceptFirstMouse": true,
        "allowLinkPreview": false,
        "windowEffects": {
          "effects": ["popover"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: http://localhost:* http://127.0.0.1:* data: preview:; media-src https: http://localhost:* http://127.0.0.1:*; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Private screenshot and file sharing",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Push.icon"
    ]
  }
}
