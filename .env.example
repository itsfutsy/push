# Copy to .env and fill in. .env is gitignored.

# The domain your links will use. Point its DNS A record at this server first.
PUSH_DOMAIN=share.example.com

# The upload token. Generate one with: openssl rand -hex 32
# You paste the same token into the app's Settings.
PUSH_TOKEN=

# Optional: where https://PUSH_DOMAIN/ sends visitors. Leave empty and the root returns 404.
PUSH_ROOT_REDIRECT=
